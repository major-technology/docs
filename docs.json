            "group": "Introduction",
            "pages": [
              "index",
              {
                "group": "Core Concepts",
                "pages": [
                  "getting-started/core-concepts",
                  "getting-started/core-concepts/apps",
                  "getting-started/core-concepts/agents",
                  "getting-started/core-concepts/models",
                  "getting-started/core-concepts/connectors",
                  "getting-started/core-concepts/rbac",
                  "getting-started/core-concepts/memory"
                ]
              }
            ]
          },
          {
            "group": "Quickstart",
            "pages": [
              "getting-started/quickstart-cli",
              "getting-started/quickstart-web"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["cli/overview", "getting-started/quickstart-cli"]
          },
          {
            "group": "Workflows",
            "pages": ["workflows/app-lifecycle"]
          },
          {
            "group": "App Commands",
            "pages": ["cli/app", "cli/resource"]
