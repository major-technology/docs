{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Major",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1E3A8A"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Introduction",
            "pages": ["index", "getting-started/core-concepts"]
          },
          {
            "group": "Quickstart",
            "pages": [
              "getting-started/quickstart-cli",
              "getting-started/quickstart-web"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["cli/overview", "getting-started/quickstart-cli"]
          },
          {
            "group": "Workflows",
            "pages": ["workflows/app-lifecycle"]
          },
          {
            "group": "App Commands",
            "pages": ["cli/app", "cli/resource"]
          },
          {
            "group": "Access & Orgs",
            "pages": ["cli/user", "cli/org"]
          },
          {
            "group": "Maintenance",
            "pages": ["cli/update"]
          }
        ]
      },
      {
        "tab": "Web Dashboard",
        "groups": [
          {
            "group": "Overview",
            "pages": ["web/index"]
          },
          {
            "group": "Features",
            "pages": [
              "web/editor",
              "web/environments",
              "web/permissions",
              "web/connectors"
            ]
          }
        ]
      },
      {
        "tab": "Resource Client",
        "groups": [
          {
            "group": "Overview",
            "pages": ["resource-client/index"]
          },
          {
            "group": "Clients",
            "pages": [
              "resource-client/postgres",
              "resource-client/dynamodb",
              "resource-client/s3",
              "resource-client/custom-api",
              "resource-client/hubspot",
              "resource-client/google-sheets"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "App editor",
          "href": "https://app.major.build",
          "icon": "window"
        },
        {
          "anchor": "CLI repository",
          "href": "https://github.com/major-technology/cli",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@major.build"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch Major",
      "href": "https://app.major.build"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
