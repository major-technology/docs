  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@major.build"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch Major",
      "href": "https://app.major.build"
    }
  },
