        "groups": [
          {
            "group": "Overview",
            "pages": ["web/index", "web/editor", "web/deploying", "web/environments", "web/authn"]
          },
          {
            "group": "Features",
            "pages": [
              "web/queries",
              "web/crons",
              "web/managed-databases",
              "web/webhooks",
              "web/mcp",
              "web/theming",
              "web/env-vars",
              "web/domains",
              "web/ai-proxy",
              "web/errors"
            ]
          }
        ]
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "Overview",
            "pages": ["agents/index"]
          },
          {
            "group": "Features",
            "pages": [
              "agents/models",
              "agents/skills",
              "agents/tool-permissions",
              "agents/schedules",
              "agents/app-triggers",
              "agents/external-channels",
